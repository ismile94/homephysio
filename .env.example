# Resend API key — required for the contact form. https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. Defaults to Resend's shared test address (onboarding@resend.dev),
# which is prone to spam filtering — point this at an address on a domain you have
# verified in Resend as soon as you have one.
CONTACT_FROM_EMAIL=hello@yourdomain.co.uk

# Where enquiries are delivered. Defaults to the address in data/site.ts.
CONTACT_TO_EMAIL=ismailaram94@gmail.com

# The canonical site URL is fixed in data/site.ts (https://www.physiovisit.co.uk).
# NEXT_PUBLIC_SITE_URL is no longer read - you can delete it from Vercel.

# Google Search Console: the content="..." value of the HTML-tag verification method.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Ads tag ID (Tools > Data manager > Google tag), e.g. AW-123456789.
# Leave empty and no Google tag or cookie banner is loaded.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Conversion labels (the part after the slash in send_to: 'AW-123456789/AbC-dEfGhIj').
NEXT_PUBLIC_GADS_LABEL_CALL=
NEXT_PUBLIC_GADS_LABEL_WHATSAPP=
NEXT_PUBLIC_GADS_LABEL_SMS=
NEXT_PUBLIC_GADS_LABEL_EMAIL=
NEXT_PUBLIC_GADS_LABEL_FORM=
